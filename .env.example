# Copy to .env and replace the placeholders. Never commit .env.

APP_NAME=Music Metadata Intelligence
APP_VERSION=1.0.0
APP_ENV=development

# Local (non-Docker) application and migrations.
DATABASE_URL=postgresql+psycopg://your_user:your_password@localhost:5432/music_metadata
# Dedicated integration test database: name must end in "_test" and differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://your_user:your_password@localhost:5432/music_metadata_test

# Docker Compose. Must use the same user and password as DATABASE_URL above.
# POSTGRES_PASSWORD only takes effect when the database volume is first created.
# Use a URL-safe password (letters, digits, - _ . ~).
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=music_metadata
# Database the Docker app container uses (e.g. music_metadata_demo for the demo).
APP_DATABASE_NAME=music_metadata
# Host ports, published on loopback only (127.0.0.1 and [::1]).
APP_PORT=8000
POSTGRES_PORT=5432
